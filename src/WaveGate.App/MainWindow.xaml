<Window x:Class="WaveGate.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaveGate.Overlay"
        Title="WaveGate" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <Style x:Key="ClipButton" TargetType="Button">
            <Setter Property="Width" Value="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height" Value="{Binding TileHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{Binding Name, Converter={StaticResource ClipColor}, ConverterParameter=deep}" />
            <Setter Property="BorderBrush" Value="#10FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" ClipToBounds="True" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard Storyboard="{StaticResource PopIn}" />
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource Grow}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource Rest}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource Press}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource Grow}" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4A4A66" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0,5,1" />
            <Setter Property="Background" Value="#47000000" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="KeyCapText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#C9CCD6" />
        </Style>

        <Style x:Key="ShareChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Height="26" MinWidth="26" CornerRadius="13" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" Margin="0,0,4,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#F20F0F15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">
        <DockPanel>
            <!-- Header doubles as the drag handle; right-click picks what the overlay shows. -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" Height="28" Background="Transparent" LastChildFill="True"
                       MouseLeftButtonDown="OnHeaderMouseDown" ContextMenuOpening="OnHeaderContextMenuOpening"
                       ToolTip="Drag to move. Right-click to choose what the overlay shows.">
                <DockPanel.ContextMenu>
                    <ContextMenu />
                </DockPanel.ContextMenu>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ShareButton" Style="{StaticResource ShareChip}" Click="OnShareClick" MouseRightButtonUp="OnShareRightClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="ShareName" FontSize="11.5" FontWeight="SemiBold" Margin="5,0,0,0" MaxWidth="90"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8F1;" FontSize="14" ToolTip="Open the library"
                            Click="OnLibraryClick" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE71A;" FontSize="13" ToolTip="Stop all"
                            Foreground="#FF8A8D" Click="OnStopAllClick" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Quit WaveGate"
                            Click="OnExitClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Grip: the header is where the overlay is dragged from. -->
                    <Grid x:Name="Grip" Width="8" Height="14" Margin="4,0,8,0" IsHitTestVisible="False">
                        <Ellipse Width="2.4" Height="2.4" Fill="#4A4E5C" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Ellipse Width="2.4" Height="2.4" Fill="#4A4E5C" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <Ellipse Width="2.4" Height="2.4" Fill="#4A4E5C" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Ellipse Width="2.4" Height="2.4" Fill="#4A4E5C" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Ellipse Width="2.4" Height="2.4" Fill="#4A4E5C" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <Ellipse Width="2.4" Height="2.4" Fill="#4A4E5C" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                    <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#6B7280" Margin="0,0,7,0" />
                    <TextBlock x:Name="SourceTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                    <TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" Margin="5,0,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <TextBlock x:Name="EmptyHint" Foreground="{StaticResource MutedBrush}" Margin="6,10" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="160" />
                <ScrollViewer x:Name="Scroller" PreviewMouseWheel="OnScrollerWheel">
                    <ItemsControl x:Name="ClipList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="Tile" Style="{StaticResource ClipButton}" Click="OnClipClick">
                                    <Button.ToolTip>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" /><LineBreak />
                                            <Run Text="{Binding Hotkey, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                        </TextBlock>
                                    </Button.ToolTip>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit…" Click="OnEditClick" />
                                            <MenuItem Header="Set hotkey…" Click="OnSetHotkeyClick" />
                                            <MenuItem Header="Clear hotkey" Click="OnClearHotkeyClick" />
                                            <Separator />
                                            <MenuItem Header="Remove from board" Click="OnRemoveClick" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid>
                                        <!-- Top/bottom edges: name on top, hotkey and waveform underneath. -->
                                        <DockPanel x:Name="Landscape" Margin="9,6,9,7">
                                            <DockPanel DockPanel.Dock="Bottom">
                                                <Border x:Name="KeyL" Style="{StaticResource KeyCap}" Margin="0,0,7,0">
                                                    <TextBlock Text="{Binding Hotkey}" Style="{StaticResource KeyCapText}" />
                                                </Border>
                                                <local:WaveformView Height="16" BarWidth="2" Peaks="{Binding Peaks}" Progress="{Binding Progress}"
                                                                    Color="{Binding Name, Converter={StaticResource ClipColor}, ConverterParameter=color}"
                                                                    IsPlaying="{Binding Playing}" IsPaused="{Binding Paused}"
                                                                    IsHighlighted="{Binding IsMouseOver, ElementName=Tile}" />
                                            </DockPanel>
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,18,0">
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13.5"
                                                           Width="{Binding TextWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Viewbox>
                                        </DockPanel>
                                        <!-- Side edges: hotkey on top, name in the middle, waveform at the bottom. -->
                                        <DockPanel x:Name="Portrait" Margin="9" Visibility="Collapsed">
                                            <Border x:Name="KeyP" DockPanel.Dock="Top" Style="{StaticResource KeyCap}" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Hotkey}" Style="{StaticResource KeyCapText}" />
                                            </Border>
                                            <local:WaveformView DockPanel.Dock="Bottom" Height="16" BarWidth="2" Peaks="{Binding Peaks}" Progress="{Binding Progress}"
                                                                Color="{Binding Name, Converter={StaticResource ClipColor}, ConverterParameter=color}"
                                                                IsPlaying="{Binding Playing}" IsPaused="{Binding Paused}"
                                                                IsHighlighted="{Binding IsMouseOver, ElementName=Tile}" />
                                            <Viewbox StretchDirection="DownOnly" Margin="0,4">
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" FontSize="14"
                                                           Width="{Binding TextWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Viewbox>
                                        </DockPanel>
                                        <Border x:Name="PauseBadge" Width="18" Height="18" CornerRadius="9" Visibility="Collapsed"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                                Background="{Binding Name, Converter={StaticResource ClipColor}}">
                                            <TextBlock Text="&#xE769;" Style="{StaticResource Glyph}" FontSize="8" Foreground="#0F0F15"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPortrait, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter TargetName="Landscape" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Portrait" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Hotkey}" Value="{x:Null}">
                                        <Setter TargetName="KeyL" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="KeyP" Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Playing}" Value="True">
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{Binding Name, Converter={StaticResource ClipColor}}" />
                                        <Setter TargetName="Tile" Property="Background" Value="{Binding Name, Converter={StaticResource ClipColor}, ConverterParameter=tint}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Paused}" Value="True">
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{Binding Name, Converter={StaticResource ClipColor}, ConverterParameter=dim}" />
                                        <Setter TargetName="PauseBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
