<Window x:Class="WaveGate.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveGate"
        Width="344" SizeToContent="Height" MaxHeight="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        FontFamily="Segoe UI" FontSize="12" Foreground="#E6E8EC">

    <Window.Resources>
        <Style x:Key="ClipButton" TargetType="Button">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Foreground" Value="#E6E8EC" />
            <Setter Property="Background" Value="#2A2F3A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A4150" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3D7BD9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource ClipButton}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#EB1B1E25" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="8">
        <DockPanel>
            <!-- Header doubles as the drag handle. -->
            <Grid DockPanel.Dock="Top" Margin="2,0,0,8" Background="Transparent"
                  MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="MicDot" Width="9" Height="9" Fill="#6B7280" VerticalAlignment="Center"
                         ToolTip="No microphone set up" />
                <TextBlock Grid.Column="1" Text="WaveGate" FontWeight="SemiBold" Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Background="#7A2E35"
                        Content="Stop all" Click="OnStopAllClick" />
                <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Content="—"
                        ToolTip="Hide (tray icon or hotkey brings it back)" Click="OnHideClick" />
            </Grid>

            <Grid>
                <TextBlock x:Name="EmptyHint" Text="Drop MP3, WAV or OGG files here"
                           Foreground="#8B93A1" Margin="0,24" HorizontalAlignment="Center" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ClipList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ClipButton}" Click="OnClipClick" ToolTip="{Binding Name}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Set hotkey…" Click="OnSetHotkeyClick" />
                                            <MenuItem Header="Clear hotkey" Click="OnClearHotkeyClick" />
                                            <Separator />
                                            <MenuItem Header="Remove from board" Click="OnRemoveClick" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="88" TextAlignment="Center" />
                                        <TextBlock Text="{Binding Hotkey}" FontSize="10" Foreground="#8B93A1"
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
