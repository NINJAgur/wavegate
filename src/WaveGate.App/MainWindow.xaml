<Window x:Class="WaveGate.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveGate" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <Style x:Key="ClipButton" TargetType="Button">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" ClipToBounds="True" BorderThickness="1"
                                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#F20F0F15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6">
        <DockPanel>
            <!-- Header doubles as the drag handle; right-click picks what the overlay shows. -->
            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,4" Background="Transparent" LastChildFill="True"
                       MouseLeftButtonDown="OnHeaderMouseDown" ContextMenuOpening="OnHeaderContextMenuOpening"
                       ToolTip="Drag to move. Right-click to choose what the overlay shows.">
                <DockPanel.ContextMenu>
                    <ContextMenu />
                </DockPanel.ContextMenu>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8F1;" FontSize="12" ToolTip="Open the library"
                            Click="OnLibraryClick" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE71A;" FontSize="12" ToolTip="Stop all"
                            Foreground="#FF8A8D" Click="OnStopAllClick" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="9" ToolTip="Quit WaveGate"
                            Click="OnExitClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#6B7280" Margin="2,0,6,0" />
                    <TextBlock x:Name="SourceTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <TextBlock x:Name="EmptyHint" Foreground="{StaticResource MutedBrush}" Margin="6,10" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="160" />
                <ScrollViewer x:Name="Scroller" PreviewMouseWheel="OnScrollerWheel">
                    <ItemsControl x:Name="ClipList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ClipButton}" Click="OnClipClick">
                                    <Button.ToolTip>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" /><LineBreak />
                                            <Run Text="{Binding Hotkey, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                        </TextBlock>
                                    </Button.ToolTip>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit…" Click="OnEditClick" />
                                            <MenuItem Header="Set hotkey…" Click="OnSetHotkeyClick" />
                                            <MenuItem Header="Clear hotkey" Click="OnClearHotkeyClick" />
                                            <Separator />
                                            <MenuItem Header="Remove from board" Click="OnRemoveClick" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid Background="{Binding Name, Converter={StaticResource ClipColor}, ConverterParameter=soft}">
                                        <Border Width="3" HorizontalAlignment="Left"
                                                Background="{Binding Name, Converter={StaticResource ClipColor}}" />
                                        <!-- Long names wrap to two lines, then shrink to fit rather than being cut off. -->
                                        <Viewbox StretchDirection="DownOnly" Margin="7,3,4,3">
                                            <TextBlock Text="{Binding Name}" Width="72" TextWrapping="Wrap" TextAlignment="Center"
                                                       FontWeight="SemiBold" />
                                        </Viewbox>
                                        <Border Height="2" VerticalAlignment="Bottom" RenderTransformOrigin="0,0.5"
                                                Background="{Binding Name, Converter={StaticResource ClipColor}}">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Progress}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
