<Window x:Class="WaveGate.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveGate"
        Width="356" SizeToContent="Height" MaxHeight="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <Style x:Key="ClipButton" TargetType="Button">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" ClipToBounds="True" BorderThickness="1"
                                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#F20F0F15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10">
        <DockPanel>
            <!-- Header doubles as the drag handle; right-click picks what the overlay shows. -->
            <Grid DockPanel.Dock="Top" Margin="4,0,0,8" Background="Transparent"
                  MouseLeftButtonDown="OnHeaderMouseDown" ContextMenuOpening="OnHeaderContextMenuOpening">
                <Grid.ContextMenu>
                    <ContextMenu />
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="&#xE767;" Style="{StaticResource Glyph}" FontSize="12" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center"
                            ToolTip="Right-click to choose what the overlay shows">
                    <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#6B7280" Margin="0,0,7,0" />
                    <TextBlock x:Name="SourceTitle" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8F1;" FontSize="14" ToolTip="Open the library"
                            Click="OnLibraryClick" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE71A;" FontSize="14" ToolTip="Stop all"
                            Foreground="#FF8A8D" Click="OnStopAllClick" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" ToolTip="Quit WaveGate"
                            Click="OnExitClick" />
                </StackPanel>
            </Grid>

            <Grid>
                <TextBlock x:Name="EmptyHint" Foreground="{StaticResource MutedBrush}" Margin="8,18" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ClipList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ClipButton}" Click="OnClipClick" ToolTip="{Binding Name}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit…" Click="OnEditClick" />
                                            <MenuItem Header="Set hotkey…" Click="OnSetHotkeyClick" />
                                            <MenuItem Header="Clear hotkey" Click="OnClearHotkeyClick" />
                                            <Separator />
                                            <MenuItem Header="Remove from board" Click="OnRemoveClick" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid Background="{Binding Name, Converter={StaticResource ClipColor}, ConverterParameter=soft}">
                                        <Border Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Left"
                                                VerticalAlignment="Top" Margin="8,8,0,0"
                                                Background="{Binding Name, Converter={StaticResource ClipColor}}">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="9"
                                                       Foreground="#0F0F15" HorizontalAlignment="Center" Margin="1,0,0,0" />
                                        </Border>
                                        <TextBlock Text="{Binding Hotkey}" FontSize="9" Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,8,0" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Bottom" Margin="8,0,8,9" />
                                        <Border Height="3" VerticalAlignment="Bottom" RenderTransformOrigin="0,0.5"
                                                Background="{Binding Name, Converter={StaticResource ClipColor}}">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Progress}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
