<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon; WPF has no tray icon of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WaveGate</AssemblyName>
    <RootNamespace>WaveGate.Overlay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid WPF/WinForms name clashes (Application, MessageBox, KeyEventArgs...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WaveGate.Audio\WaveGate.Audio.csproj" />
  </ItemGroup>

</Project>
