<Window x:Class="WaveGate.Overlay.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaveGate.Overlay"
        Title="WaveGate" Icon="/Assets/WaveGate.ico" Width="1040" Height="680" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <Window.Resources>
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="132" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Colours come from the button so the item template can show playing/paused. -->
                        <Border x:Name="Bg" CornerRadius="14" ClipToBounds="True" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard Storyboard="{StaticResource PopIn}" />
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource Grow}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource Rest}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource Press}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource Grow}" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                    <Setter Property="BorderBrush" Value="#4A4A66" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="DragOver" Handler="OnCategoryDragOver" />
            <EventSetter Event="Drop" Handler="OnCategoryDrop" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,9" Margin="0,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="232" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                    <Image Source="/Assets/WaveGate.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="Fant" />
                    <TextBlock Text="WaveGate" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Mic link + volumes at the bottom of the sidebar -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource WgButton}" Click="OnNewCategoryClick" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="New category" />
                        </StackPanel>
                    </Button>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="13"
                                        VerticalAlignment="Top" Margin="0,-4,-6,0" ToolTip="Microphone options"
                                        Click="OnMicOptionsClick">
                                    <Button.ContextMenu>
                                        <ContextMenu />
                                    </Button.ContextMenu>
                                </Button>
                                <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="-4,1,0,0">
                                    <Ellipse x:Name="MicHalo" Fill="#6B7280" Opacity="0.18" />
                                    <Ellipse x:Name="MicDot" Width="8" Height="8" Fill="#6B7280" />
                                </Grid>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock x:Name="MicTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="MicDevice" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Others hear" Width="70" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" ToolTip="How loud others hear clips" />
                                <TextBlock x:Name="MicVolumeText" DockPanel.Dock="Right" Width="36" TextAlignment="Right"
                                           FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="MicVolumeSlider" Minimum="0" Maximum="1" Margin="4,0,6,0"
                                        ValueChanged="OnMicVolumeChanged" ToolTip="How loud others hear clips" />
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="You hear" Width="70" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" ToolTip="How loud you hear clips in your earphones" />
                                <TextBlock x:Name="SidetoneText" DockPanel.Dock="Right" Width="36" TextAlignment="Right"
                                           FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="SidetoneSlider" Minimum="0" Maximum="1" Margin="4,0,6,0"
                                        ValueChanged="OnSidetoneChanged" ToolTip="How loud you hear clips" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnCategorySelected" ContextMenuOpening="OnCategoryContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu />
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Glyph}" FontSize="14" Width="26"
                                           Foreground="{StaticResource MutedBrush}" />
                                <Border DockPanel.Dock="Right" CornerRadius="8" Padding="7,1" Background="#14FFFFFF">
                                    <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="28,22,28,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Share split button: the left part toggles, the arrow picks which app is sent into the mic. -->
                <Border x:Name="SharePill" CornerRadius="23" Padding="4,4,6,4" BorderThickness="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                <Button x:Name="ShareToggle" Click="OnShareToggleClick" Width="36" Height="36" Cursor="Hand"
                        FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Ring" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                                         StrokeThickness="2" />
                                <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="ShareDrop" Style="{StaticResource IconButton}" Click="OnShareDropClick" Margin="2,0,0,0"
                        VerticalAlignment="Center" ToolTip="Choose which app to send into your mic, or turn sharing off">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center" Margin="2,0,8,0">
                            <TextBlock x:Name="ShareCaption" FontFamily="{StaticResource UiFont}" FontSize="11" />
                            <TextBlock x:Name="ShareLabel" FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold"
                                       MaxWidth="150" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                        <TextBlock Text="&#xE70D;" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Button>
                </StackPanel>
                </Border>
                <Button Style="{StaticResource WgButton}" Click="OnAddFolderClick" Margin="16,0,0,0" ToolTip="Each subfolder becomes a category">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="Add folder" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Click="OnAddFilesClick" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="Add sounds" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DangerButton}" Click="OnStopAllClick" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="Stop all" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="ViewTitle" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ViewSubtitle" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Search + sort -->
        <DockPanel DockPanel.Dock="Top" Margin="28,8,28,10">
            <ComboBox x:Name="SortBox" DockPanel.Dock="Right" Width="170" Margin="10,0,0,0" SelectionChanged="OnSortChanged">
                <ComboBoxItem Content="Sort: Name" IsSelected="True" />
                <ComboBoxItem Content="Sort: Recently added" />
            </ComboBox>
            <Grid MaxWidth="420" HorizontalAlignment="Left" Width="420">
                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Padding="36,9,10,9" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="{StaticResource MutedBrush}"
                           Margin="13,0,0,0" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Search sounds" Foreground="{StaticResource MutedBrush}"
                           Margin="37,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <!-- Clip grid -->
        <Grid Margin="22,4,14,14">
            <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="42" HorizontalAlignment="Center"
                           Foreground="#3A3A4C" />
                <TextBlock x:Name="EmptyText" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ClipGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="TileButton" Style="{StaticResource Tile}" Click="OnClipClick" ToolTip="{Binding Name}"
                                    PreviewMouseLeftButtonDown="OnTileMouseDown" PreviewMouseMove="OnTileMouseMove"
                                    ContextMenuOpening="OnTileContextMenuOpening">
                                <Button.ContextMenu>
                                    <ContextMenu />
                                </Button.ContextMenu>
                                <DockPanel Margin="14,12,14,12">
                                    <DockPanel DockPanel.Dock="Top">
                                        <Button Style="{StaticResource IconButton}" Click="OnStarClick" FontSize="14" DockPanel.Dock="Right"
                                                Margin="0,-6,-8,-6" ToolTip="Favorite (shown in the overlay)">
                                            <TextBlock x:Name="Star" Text="&#xE734;" />
                                        </Button>
                                        <Border x:Name="PlayBadge" DockPanel.Dock="Right" Width="24" Height="24" CornerRadius="12"
                                                Margin="0,-4,4,-4" Opacity="0" IsHitTestVisible="False"
                                                Background="{Binding Name, Converter={StaticResource ClipColor}}">
                                            <TextBlock x:Name="PlayGlyph" Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="10"
                                                       Foreground="#0F0F15" HorizontalAlignment="Center" Margin="1,0,0,0" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DockPanel DockPanel.Dock="Bottom">
                                        <Border x:Name="KeyCap" CornerRadius="5" Padding="6,1,6,1" Background="#24242F"
                                                BorderBrush="#33333F" BorderThickness="1,1,1,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Hotkey}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                                       Foreground="#C9CCD6" />
                                        </Border>
                                        <TextBlock x:Name="NoHotkey" Text="No hotkey" Visibility="Collapsed" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="PausedGlyph" Text="&#xE769;" Style="{StaticResource Glyph}" FontSize="9"
                                                       Margin="0,0,5,0" Visibility="Collapsed" />
                                            <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- The waveform is also the seek bar: drag on it to move through the clip. -->
                                    <local:WaveformView x:Name="SeekBar" Height="38" Margin="0,8" Cursor="Hand" ToolTip="Drag to seek"
                                                        Peaks="{Binding Peaks}" Progress="{Binding Progress}"
                                                        Color="{Binding Name, Converter={StaticResource ClipColor}, ConverterParameter=color}"
                                                        IsPlaying="{Binding Playing}" IsPaused="{Binding Paused}" ShowPlayhead="True"
                                                        IsHighlighted="{Binding IsMouseOver, ElementName=TileButton}"
                                                        MouseLeftButtonDown="OnSeekDown" MouseMove="OnSeekMove" MouseLeftButtonUp="OnSeekUp" />
                                </DockPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Favorite}" Value="True">
                                    <Setter TargetName="Star" Property="Text" Value="&#xE735;" />
                                    <Setter TargetName="Star" Property="Foreground" Value="{StaticResource StarBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Hotkey}" Value="{x:Null}">
                                    <Setter TargetName="KeyCap" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="NoHotkey" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <Trigger SourceName="TileButton" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PlayBadge" Property="Opacity" Value="1" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Playing}" Value="True">
                                    <Setter TargetName="TileButton" Property="BorderBrush" Value="{Binding Name, Converter={StaticResource ClipColor}}" />
                                    <Setter TargetName="TileButton" Property="Background" Value="{Binding Name, Converter={StaticResource ClipColor}, ConverterParameter=tint}" />
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{Binding Name, Converter={StaticResource ClipColor}, ConverterParameter=bright}" />
                                    <Setter TargetName="PlayGlyph" Property="Text" Value="&#xE769;" />
                                    <Setter TargetName="PlayGlyph" Property="Margin" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Paused}" Value="True">
                                    <Setter TargetName="TileButton" Property="BorderBrush" Value="{Binding Name, Converter={StaticResource ClipColor}, ConverterParameter=dim}" />
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter TargetName="PausedGlyph" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="PlayGlyph" Property="Text" Value="&#xE768;" />
                                    <Setter TargetName="PlayGlyph" Property="Margin" Value="1,0,0,0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>