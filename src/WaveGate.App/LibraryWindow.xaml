<Window x:Class="WaveGate.Overlay.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveGate" Width="980" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <Window.Resources>
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Width" Value="156" />
            <Setter Property="Height" Value="86" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" ClipToBounds="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="AllowDrop" Value="True" />
            <EventSetter Event="DragOver" Handler="OnCategoryDragOver" />
            <EventSetter Event="Drop" Handler="OnCategoryDrop" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,7" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Status and volumes -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="14,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="MicDot" Width="9" Height="9" Fill="#6B7280" VerticalAlignment="Center" />
                    <TextBlock x:Name="MicText" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Mic volume" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <Slider x:Name="MicVolumeSlider" Width="140" Minimum="0" Maximum="1" Margin="8,0,4,0"
                            VerticalAlignment="Center" ValueChanged="OnMicVolumeChanged"
                            ToolTip="How loud clips are for the people you talk to" />
                    <TextBlock x:Name="MicVolumeText" Width="38" VerticalAlignment="Center" />
                    <TextBlock Text="Earphones" Margin="20,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                    <Slider x:Name="SidetoneSlider" Width="140" Minimum="0" Maximum="1" Margin="8,0,4,0"
                            VerticalAlignment="Center" ValueChanged="OnSidetoneChanged"
                            ToolTip="How loud clips are in your own earphones" />
                    <TextBlock x:Name="SidetoneText" Width="38" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Categories -->
        <Border DockPanel.Dock="Left" Width="210" Background="{StaticResource PanelBrush}" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="LIBRARY" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="10,4,0,8" />
                <Button DockPanel.Dock="Bottom" Style="{StaticResource WgButton}" Content="+ New category"
                        Margin="0,8,0,0" Click="OnNewCategoryClick" />
                <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnCategorySelected" ContextMenuOpening="OnCategoryContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu />
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <TextBlock x:Name="ViewTitle" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold"
                   Margin="16,14,16,0" TextTrimming="CharacterEllipsis" />
        <Grid DockPanel.Dock="Top" Margin="16,10,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" VerticalContentAlignment="Center" />
                <TextBlock x:Name="SearchHint" Text="Search" Foreground="{StaticResource MutedBrush}"
                           Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <ComboBox x:Name="SortBox" Grid.Column="1" Width="150" Margin="8,0,0,0" SelectionChanged="OnSortChanged">
                <ComboBoxItem Content="Name" IsSelected="True" />
                <ComboBoxItem Content="Recently added" />
            </ComboBox>
            <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Add sounds" Margin="8,0,0,0"
                    Click="OnAddFilesClick" />
            <Button Grid.Column="3" Style="{StaticResource WgButton}" Content="Add folder" Margin="8,0,0,0"
                    Click="OnAddFolderClick" ToolTip="Each subfolder becomes a category" />
            <Button Grid.Column="4" Style="{StaticResource DangerButton}" Content="Stop all" Margin="8,0,0,0"
                    Click="OnStopAllClick" />
        </Grid>

        <!-- Clip grid -->
        <Grid Margin="10,4,10,10">
            <TextBlock x:Name="EmptyHint" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ClipGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Tile}" Click="OnClipClick" ToolTip="{Binding Name}"
                                    PreviewMouseLeftButtonDown="OnTileMouseDown" PreviewMouseMove="OnTileMouseMove"
                                    ContextMenuOpening="OnTileContextMenuOpening">
                                <Button.ContextMenu>
                                    <ContextMenu />
                                </Button.ContextMenu>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               Margin="10,8,10,26" MaxHeight="40" />
                                    <DockPanel VerticalAlignment="Bottom" Margin="10,0,6,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Click="OnStarClick" FontSize="15" ToolTip="Favorite (shown in the overlay)">
                                            <TextBlock x:Name="Star" Text="☆" />
                                        </Button>
                                        <TextBlock Text="{Binding Hotkey}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <Border Height="3" VerticalAlignment="Bottom" Background="{StaticResource AccentBrush}"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Progress}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Favorite}" Value="True">
                                    <Setter TargetName="Star" Property="Text" Value="★" />
                                    <Setter TargetName="Star" Property="Foreground" Value="{StaticResource StarBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
