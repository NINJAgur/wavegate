<Window x:Class="WaveGate.Overlay.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveGate" Icon="/Assets/WaveGate.ico" Width="1040" Height="680" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <Window.Resources>
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Width" Value="176" />
            <Setter Property="Height" Value="112" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" ClipToBounds="True" BorderThickness="1"
                                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard Storyboard="{StaticResource PopIn}" />
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#4A4A66" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource Grow}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource Rest}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource Press}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource Grow}" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="DragOver" Handler="OnCategoryDragOver" />
            <EventSetter Event="Drop" Handler="OnCategoryDrop" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,9" Margin="0,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="232" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                    <Image Source="/Assets/WaveGate.ico" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="WaveGate" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Mic link + volumes at the bottom of the sidebar -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource WgButton}" Click="OnNewCategoryClick" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="New category" />
                        </StackPanel>
                    </Button>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="13"
                                        VerticalAlignment="Top" Margin="0,-4,-6,0" ToolTip="Microphone options"
                                        Click="OnMicOptionsClick">
                                    <Button.ContextMenu>
                                        <ContextMenu />
                                    </Button.ContextMenu>
                                </Button>
                                <Ellipse x:Name="MicDot" Width="8" Height="8" Fill="#6B7280" VerticalAlignment="Center" />
                                <TextBlock x:Name="MicText" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="&#xE720;" Style="{StaticResource Glyph}" Foreground="{StaticResource MutedBrush}"
                                           ToolTip="Mic volume: how loud others hear clips" />
                                <TextBlock x:Name="MicVolumeText" DockPanel.Dock="Right" Width="36" TextAlignment="Right"
                                           FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="MicVolumeSlider" Minimum="0" Maximum="1" Margin="10,0,6,0"
                                        ValueChanged="OnMicVolumeChanged" ToolTip="How loud others hear clips" />
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="&#xE7F6;" Style="{StaticResource Glyph}" Foreground="{StaticResource MutedBrush}"
                                           ToolTip="Earphones: how loud you hear clips" />
                                <TextBlock x:Name="SidetoneText" DockPanel.Dock="Right" Width="36" TextAlignment="Right"
                                           FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="SidetoneSlider" Minimum="0" Maximum="1" Margin="10,0,6,0"
                                        ValueChanged="OnSidetoneChanged" ToolTip="How loud you hear clips" />
                            </DockPanel>
                            <DockPanel Margin="0,10,0,0"
                                       ToolTip="Sends everything this app plays (a YouTube tab, a clip on X...) into your mic. Other apps, like Discord, are not included.">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" Foreground="{StaticResource MutedBrush}" />
                                <ComboBox x:Name="ShareBox" Margin="10,0,0,0" FontSize="12" DisplayMemberPath="Name"
                                          DropDownOpened="OnShareDropDownOpened" SelectionChanged="OnShareChanged" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnCategorySelected" ContextMenuOpening="OnCategoryContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu />
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Glyph}" FontSize="14" Width="26"
                                           Foreground="{StaticResource MutedBrush}" />
                                <Border DockPanel.Dock="Right" CornerRadius="8" Padding="7,1" Background="#14FFFFFF">
                                    <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="28,22,28,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource WgButton}" Click="OnAddFolderClick" ToolTip="Each subfolder becomes a category">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="Add folder" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Click="OnAddFilesClick" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="Add sounds" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DangerButton}" Click="OnStopAllClick" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="Stop all" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="ViewTitle" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ViewSubtitle" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Search + sort -->
        <DockPanel DockPanel.Dock="Top" Margin="28,8,28,10">
            <ComboBox x:Name="SortBox" DockPanel.Dock="Right" Width="170" Margin="10,0,0,0" SelectionChanged="OnSortChanged">
                <ComboBoxItem Content="Sort: Name" IsSelected="True" />
                <ComboBoxItem Content="Sort: Recently added" />
            </ComboBox>
            <Grid MaxWidth="420" HorizontalAlignment="Left" Width="420">
                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Padding="36,9,10,9" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="{StaticResource MutedBrush}"
                           Margin="13,0,0,0" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Search sounds" Foreground="{StaticResource MutedBrush}"
                           Margin="37,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <!-- Clip grid -->
        <Grid Margin="22,4,14,14">
            <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="42" HorizontalAlignment="Center"
                           Foreground="#3A3A4C" />
                <TextBlock x:Name="EmptyText" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ClipGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Tile}" Click="OnClipClick" ToolTip="{Binding Name}"
                                    PreviewMouseLeftButtonDown="OnTileMouseDown" PreviewMouseMove="OnTileMouseMove"
                                    ContextMenuOpening="OnTileContextMenuOpening">
                                <Button.ContextMenu>
                                    <ContextMenu />
                                </Button.ContextMenu>
                                <Grid Background="{Binding Name, Converter={StaticResource ClipColor}, ConverterParameter=soft}">
                                    <Border Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="12,12,0,0" Background="{Binding Name, Converter={StaticResource ClipColor}}">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="14" Foreground="#0F0F15"
                                                   HorizontalAlignment="Center" Margin="2,0,0,0" />
                                    </Border>
                                    <Button Style="{StaticResource IconButton}" Click="OnStarClick" FontSize="15"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                            ToolTip="Favorite (shown in the overlay)">
                                        <TextBlock x:Name="Star" Text="&#xE734;" />
                                    </Button>
                                    <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,12">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="HotkeyText" Text="{Binding Hotkey}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <!-- Seek bar: a taller invisible hit area over the thin progress line. -->
                                    <Grid x:Name="SeekBar" Height="14" VerticalAlignment="Bottom" Background="Transparent"
                                          Cursor="Hand" ToolTip="Drag to seek"
                                          MouseLeftButtonDown="OnSeekDown" MouseMove="OnSeekMove" MouseLeftButtonUp="OnSeekUp">
                                        <Border x:Name="SeekTrack" Height="3" VerticalAlignment="Bottom" Background="#33FFFFFF"
                                                Opacity="0" />
                                        <Border x:Name="SeekFill" Height="3" VerticalAlignment="Bottom"
                                                Background="{Binding Name, Converter={StaticResource ClipColor}}"
                                                RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Progress}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Favorite}" Value="True">
                                    <Setter TargetName="Star" Property="Text" Value="&#xE735;" />
                                    <Setter TargetName="Star" Property="Foreground" Value="{StaticResource StarBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Hotkey}" Value="{x:Null}">
                                    <Setter TargetName="HotkeyText" Property="Text" Value="No hotkey" />
                                    <Setter TargetName="HotkeyText" Property="Opacity" Value="0.6" />
                                </DataTrigger>
                                <Trigger SourceName="SeekBar" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SeekTrack" Property="Opacity" Value="1" />
                                    <Setter TargetName="SeekTrack" Property="Height" Value="6" />
                                    <Setter TargetName="SeekFill" Property="Height" Value="6" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
